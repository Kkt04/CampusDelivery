# Copy to .env and adjust. Never commit a real .env file.
ENVIRONMENT=development

# PostgreSQL (primary database). For the SQLite fallback see README.
DATABASE_URL=postgresql+psycopg://campus:campus@localhost:5432/campus_delivery
# DATABASE_URL=sqlite:///./campus_delivery.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60

PICKUP_CODE_TTL_MINUTES=30
PICKUP_CODE_MAX_ATTEMPTS=5
COLLECTION_DEADLINE_DAYS=5

# first_available | suitable_size
STORAGE_ALLOCATION_STRATEGY=suitable_size
# Comma separated: in_app, console_email
NOTIFICATION_CHANNELS=in_app,console_email

CORS_ORIGINS=http://localhost:5173
