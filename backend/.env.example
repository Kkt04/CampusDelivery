# Copy to .env and adjust. Never commit a real .env file.
ENVIRONMENT=development

# MongoDB connection.
MONGO_URL=mongodb://localhost:27017
MONGO_DB=campus_delivery

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

PICKUP_CODE_TTL_MINUTES=30
PICKUP_CODE_MAX_ATTEMPTS=5
COLLECTION_DEADLINE_DAYS=3

# first_available | suitable_size
STORAGE_ALLOCATION_STRATEGY=suitable_size
# Comma separated: in_app, console_email, smtp_email
NOTIFICATION_CHANNELS=in_app,console_email

# SMTP Email Configuration (used when smtp_email is added to NOTIFICATION_CHANNELS)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@campus.example.edu
SMTP_USE_TLS=true

# Security & Reverse Proxy Settings
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
TRUSTED_PROXIES=127.0.0.1,::1

CORS_ORIGINS=http://localhost:5173

