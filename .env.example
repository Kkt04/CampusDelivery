# ==============================================================================
# Campus Delivery Management System (CDMS) - Root Environment Configuration
# ==============================================================================
# Copy this file to:
#   1. backend/.env   (for FastAPI backend configuration)
#   2. frontend/.env  (for Vite React frontend configuration, if customizing API URL)
#
# NEVER commit a real .env file with secrets into version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME="Campus Delivery Management System"
ENVIRONMENT=development    # development | test | production

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MongoDB)
# ------------------------------------------------------------------------------
MONGO_URL=mongodb://localhost:27017
MONGO_DB=campus_delivery

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY (JWT & Bcrypt)
# ------------------------------------------------------------------------------
# Generate a strong 256-bit secret using: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
# 4. BUSINESS & CUSTODY RULES
# ------------------------------------------------------------------------------
PICKUP_CODE_TTL_MINUTES=30
PICKUP_CODE_MAX_ATTEMPTS=5
COLLECTION_DEADLINE_DAYS=3

# Storage allocation strategy: "suitable_size" (best-fit) | "first_available" (code-order)
STORAGE_ALLOCATION_STRATEGY=suitable_size

# Active notification channels (comma-separated): in_app, console_email, smtp_email
NOTIFICATION_CHANNELS=in_app,console_email
NOTIFICATION_MAX_ATTEMPTS=3

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL CONFIGURATION (Required only if "smtp_email" is in NOTIFICATION_CHANNELS)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@campus.example.edu
SMTP_USE_TLS=true

# ------------------------------------------------------------------------------
# 6. REVERSE PROXY & ABUSE PROTECTION (Rate Limiting)
# ------------------------------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
TRUSTED_PROXIES=127.0.0.1,::1

# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------------------
# 7. FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# Base path of the REST API (default works with Vite dev proxy and Nginx)
VITE_API_BASE_URL=/api/v1
