classDiagram
    direction TB
    class BaseDocument {
        <<abstract>>
        +int id
        +datetime created_at
        +datetime updated_at
        +to_doc() dict
        +from_doc(d) Document
    }

    class User {
        +int id
        +string email
        +string full_name
        +UserRole role
        +string phone
        +bool is_active
        +is_learner() bool
        +can_perform(perm) bool
    }

    class Package {
        +int id
        +string tracking_id
        +string internal_code
        +int recipient_user_id
        +CourierService courier
        +PackageSize size
        +PackageStatus status
        +int storage_location_id
        +datetime arrival_date
        +is_overdue() bool
        +can_transition_to(target) bool
    }

    class StorageLocation {
        +int id
        +string code
        +string zone
        +PackageSize size_class
        +int capacity
        +int occupied_count
        +bool is_active
        +accepts(pkg_size) bool
        +available_slots() int
    }

    class PickupToken {
        +int id
        +int package_id
        +string token_hash
        +datetime expires_at
        +datetime used_at
        +int attempt_count
        +is_valid() bool
        +verify(code) bool
    }

    class PickupRecord {
        +int id
        +int package_id
        +int token_id
        +int verified_by_user_id
        +datetime collected_at
    }

    BaseDocument <|-- User
    BaseDocument <|-- Package
    BaseDocument <|-- StorageLocation
    BaseDocument <|-- PickupToken
    BaseDocument <|-- PickupRecord

    User "1" --> "0..*" Package : receives
    Package "0..1" --> "0..1" StorageLocation : placed_in
    Package "1" --> "0..*" PickupToken : authenticated_by
    Package "1" --> "1" PickupRecord : verified_receipt
