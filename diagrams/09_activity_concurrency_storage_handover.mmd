flowchart LR
    subgraph StorageLane ["Lane 1: Concurrent Storage Reservation"]
        direction TB
        S1([Package Ready to Shelf]) --> S2[Fetch Matching Active Shelves]
        S2 --> S3[Strategy Ranks Candidates]
        S3 --> S4[Atomic CAS Update: occupied_count < capacity]
        S4 --> S5{Slot Reserved?}
        S5 -->|No: Full| S3
        S5 -->|Yes| S6[Package Assigned & Status=READY]
        S6 --> SEnd([Storage Assigned])
    end

    subgraph HandoverLane ["Lane 2: Concurrent Handover & Token Barrier"]
        direction TB
        H1([Learner at Counter]) --> H2[Submit 6-Digit Token]
        H2 --> H3[Token-Bucket Rate Limit Check]
        H3 --> H4[Atomic CAS Update: used_at == null]
        H4 --> H5{Valid & Unused?}
        H5 -->|No| H6[Reject: 409 Conflict]
        H6 --> HEndFail([Handover Aborted])
        H5 -->|Yes| H7[Create Pickup Record & Release Shelf]
        H7 --> H8[Status = COLLECTED]
        H8 --> HEndPass([Handover Completed])
    end
