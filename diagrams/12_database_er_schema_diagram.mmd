erDiagram
    users ||--o{ packages : "receives"
    storage_locations ||--o{ packages : "stores"
    packages ||--o{ pickup_tokens : "authenticates"
    packages ||--|| pickup_records : "generates receipt"

    users {
        int id PK
        string email UK
        string full_name
        string role
        string password_hash
        bool is_active
    }

    packages {
        int id PK
        string tracking_id UK
        string internal_code UK
        int recipient_user_id FK
        int storage_location_id FK
        string status
        string size
        string courier
    }

    storage_locations {
        int id PK
        string code UK
        string zone
        string size_class
        int capacity
        int occupied_count
        bool is_active
    }

    pickup_tokens {
        int id PK
        int package_id FK
        string token_hash
        datetime expires_at
        datetime used_at
        int attempt_count
    }

    pickup_records {
        int id PK
        int package_id UK_FK
        int token_id UK_FK
        int verified_by_user_id FK
        datetime collected_at
    }
