classDiagram
    direction TB
    namespace PresentationLayer {
        class PackagesRouter {
            +intake(dto)
            +assign_storage(id)
        }
        class PickupsRouter {
            +request_pickup(id)
            +verify_handover(dto)
        }
    }

    namespace ApplicationLayer {
        class PackageIntakeService {
            +register(dto)
            +triage_recipient(id)
        }
        class StorageAllocationService {
            -StorageAllocationStrategy strategy
            +allocate_storage(pkg_id)
        }
        class PickupService {
            +generate_pickup_code(pkg_id)
            +verify_and_handover(code, staff)
        }
    }

    namespace DomainLayer {
        class IUnitOfWork {
            <<protocol>>
            +commit()
            +rollback()
        }
        class StorageAllocationStrategy {
            <<protocol>>
            +rank(candidates, size) list
        }
        class PackageStateMachine {
            <<pure domain>>
            +check(curr, target, role, pkg)
        }
    }

    namespace InfrastructureLayer {
        class MongoUnitOfWork {
            +commit()
            +rollback()
        }
        class SuitableSizeStrategy {
            +rank(candidates, size) list
        }
    }

    PackagesRouter --> PackageIntakeService
    PackagesRouter --> StorageAllocationService
    PickupsRouter --> PickupService

    PackageIntakeService --> IUnitOfWork
    StorageAllocationService --> StorageAllocationStrategy
    PickupService --> PackageStateMachine

    IUnitOfWork <|.. MongoUnitOfWork
    StorageAllocationStrategy <|.. SuitableSizeStrategy
